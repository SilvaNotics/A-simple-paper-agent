# ============================================================================
# 环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 忽略，不会被提交）
#
#   cp .env.example .env
#
# 也可以完全不改这个文件：启动 `python main.py` 后用 /connect 交互配置供应商，
# 配置会写到 ~/.config/paper-agent/config.json（JSON 配置优先于 .env）。
# ============================================================================

# ---------------------------------------------------------------------------
# 方案 A（默认）：DashScope / 阿里云百炼 —— 同时提供对话与 embedding
#   DASHSCOPE_MODEL 建议 qwen3.8-max / qwen-max / qwen-plus
#   embedding 默认 text-embedding-v4（1024 维），也可用 /models --embedding 换
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max

# 思考模式（默认都不设 = 不传 enable_thinking，交给服务端；glm-5.3 等只能开思考的模型必须保持默认）：
#   DASHSCOPE_ENABLE_THINKING=1   显式开启（传 true）——注意 thinking 下 DashScope 不接受 tool_choice
#   DISABLE_THINKING=1            显式关闭（传 false）

# ---------------------------------------------------------------------------
# 方案 B（备用）：DeepSeek —— 只有对话模型，RAG 需要另配 embedding（如方案 A）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 方案 C：任意 OpenAI 兼容端点（也可直接用 main.py 的 /connect 配置）
# ---------------------------------------------------------------------------
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=
# LLM_MODEL=kimi-k2-0905-preview
# LLM_EMBEDDING_MODEL=BAAI/bge-m3   # 该供应商自带的 embedding 模型

# 单独指定 embedding（与对话供应商解耦：对话 A + embedding B）
# 留空则用对话供应商自带的，或回退到方案 A 的 DashScope。
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024            # 不确定可留空（仅用于索引签名，便于发现维度不匹配）

# ---------------------------------------------------------------------------
# 联网检索（内置 HTTP 层：免 key，MCP 不可用时自动回退）
# ---------------------------------------------------------------------------
# SEARCH_SOURCE=auto             # auto（MCP→内置回退）/ mcp / builtin
# 所有渠道默认禁用：先用 `/channels add <编号|kind>` 逐个启用（或在此用 BUILTIN_SOURCES 显式列一批）：
# BUILTIN_SOURCES=arxiv,openalex,crossref,europepmc,pubmed,doaj,chinaxiv,nlc
# PREFER_DOMESTIC=1              # 是否优先国内渠道（源排序 + 结果排序）；`/channels domestic off` 可关
# 国内数据库也可用 /channels add 配置（写入本地 JSON）：
#   chinaxiv       免 key（可选 email 进 polite pool）
#   nlc            国家图书馆联合目录，免 key（图书/古籍/学位论文书目+馆藏）
#   baidu_scholar  需千帆 Bearer key；wanfang 需 APPCODE（或 AppKey:APPCODE）
#
# 全渠道并发检索：打开后每次检索会**并发跑全部已注册渠道**（免 key 的 + 已配置 key 的；
# 缺 key 的自动跳过）。等价于 REPL 的 `/channels all on`。
# SEARCH_ALL_CHANNELS=1
# CHANNEL_CONCURRENCY=6   # 全渠道并发上限
# CHANNEL_TIMEOUT=25      # 单渠道超时（秒），避免个别慢源拖垬整次检索
# MAX_TOTAL_RESULTS=200   # `/search --limit` 是每渠道上限，这里是汇总总上限（防爆炸）
# OPENALEX_MAILTO=you@example.com  # 进 polite pool，更稳定
# ARXIV_MIN_INTERVAL=3.0         # arXiv 官方要求 ≥3s
# HTTP_TIMEOUT=30
# HTTP_USER_AGENT=paper-agent/0.1 (+mailto:you@example.com)
# LLM_TIMEOUT=180                # 单次等待模型/embedding 响应上限（秒）
# SEARCH_TIMEOUT=180             # 一次检索（含 LLM 扩展/重排）的总超时（秒）
# SEARCH_USE_LLM=true            # 检索过程中用 LLM 做查询扩展 + 相关性重排

# ---------------------------------------------------------------------------
# MCP 检索相关（可选，提升覆盖面/稳定性）
# ---------------------------------------------------------------------------
# SEMANTIC_SCHOLAR_API_KEY=      # 透传给 arxiv-mcp-server / paper-search-mcp；配置后自动启用 semantic 源
# MCP_DEFAULT_SOURCES=           # 固定 search_papers 的源（默认空 = 跟随 /channels 启用的渠道）
# UNPAYWALL_EMAIL=you@example.com  # paper-search 解析开放获取链接
# ARXIV_MCP_BIN=/abs/path/arxiv-mcp-server      # 自定义 MCP 可执行文件路径
# PAPER_SEARCH_MCP_BIN=/abs/path/paper-search-mcp

# ---------------------------------------------------------------------------
# 界面主题（补全菜单 / 命令面板 / 底部状态栏）
#   dark（默认）：深色底 + 蓝色字；light：浅色底 + 蓝色字；none：库默认配色
# ---------------------------------------------------------------------------
# PAPER_AGENT_THEME=dark

# ---------------------------------------------------------------------------
# 运行参数（默认值见 src/paper_agent/config.py）
# ---------------------------------------------------------------------------
# PAPER_AGENT_DATA_DIR=data        # PDF 缓存 + 向量索引目录
# PAPER_AGENT_CONFIG=~/.config/paper-agent/config.json   # /connect 写入的配置文件
# PAPER_AGENT_IGNORE_USER_CONFIG=1 # 设为 1 时只用 .env，忽略 JSON 配置
# PAPER_AGENT_FAKE_LLM=1           # 离线自检（假模型 + 假 embedding）
# TOP_K=6
# MAX_PAPERS=8
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# EMBED_BATCH_SIZE=10              # DashScope embedding 单批上限（实测 10）
# CONCURRENCY=4
# MIN_SUPPORT_RATIO=0.3            # 引用原文支撑度阈值
# HYBRID_RETRIEVAL=false           # 开启需安装 rank-bm25 + langchain-community
# SEARCH_SOURCES=                # 显式覆盖检索源；默认空 = 用 /channels 启用的渠道（不要用 all，SSRN/BASE 很慢）
